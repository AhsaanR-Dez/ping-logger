{
    "compilerOptions": {
      "target": "ES2023",
      "lib": ["ES2023"],
      "types": ["node"],
      "module": "nodenext",
      "moduleResolution": "nodenext",
      "rootDir": "src",
      "outDir": "dist",
  
      "strict": true,
      "noUncheckedIndexedAccess": true,
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "noImplicitReturns": true,
  
      "verbatimModuleSyntax": true,
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "skipLibCheck": true,
      "sourceMap": true
    },
    "include": ["src/**/*"]
  }